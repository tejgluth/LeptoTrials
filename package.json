{
  "name": "leptomeningeal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "tsx --test functions/_lib/*.test.ts functions/api/*.test.ts tests/*.test.ts",
    "check": "npm run test && npm run lint && npm run build",
    "dev:cloudflare": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name lm-trials",
    "d1:migrate:local": "wrangler d1 migrations apply leptotrials-analytics --local",
    "d1:migrate:remote": "wrangler d1 migrations apply leptotrials-analytics --remote",
    "preview": "vite preview",
    "export:audit-universe": "npx tsx scripts/export-audit-universe.ts",
    "export:expanded-candidates": "npx tsx scripts/export-expanded-candidates.ts",
    "generate:manual-audit-overrides": "npx tsx scripts/generate-manual-audit-overrides.ts",
    "reconcile:manual-audit": "npx tsx scripts/reconcile-manual-audit.ts",
    "validate:trials": "npx tsx scripts/validate-trials.ts"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  }
}
